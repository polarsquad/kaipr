{
  // Renovate config for kaipr.
  // Runs via the hosted Renovate GitHub App.
  // Version sources covered:
  //   - Flux / Helm / Kubernetes manifests under workload/
  //   - GitHub Actions workflow action pins (.github/workflows/)
  //   - mise tool pins (explicit per-tool custom managers below; the native
  //     mise manager is disabled so dep resolution is deterministic)
  //   - annotated chart pins in bootstrap.toml (consumed by the Rust binary)
  //   - toolbox image pins in bootstrap-rs/Dockerfile
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":disableRateLimiting"
  ],
  "schedule": ["after 6am on monday"],
  "timezone": "Europe/Helsinki",
  "rangeStrategy": "pin",
  "separateMajorMinor": false,
  "suppressNotifications": ["prEditedNotification", "prIgnoreNotification"],
  "rebaseWhen": "conflicted",
  "flux": {
    "managerFilePatterns": ["/(^|/)workload/.+\\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/(^|/)workload/.+\\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/(^|/)workload/.+\\\.ya?ml$/"]
  },
  // Explicit per-tool custom managers replace the native mise manager so each
  // tool resolves against the exact upstream GitHub repo we install from.
  "mise": {
    "enabled": false
  },
  "customManagers": [
    // ── mise tool pins ────────────────────────────────────────────────────
    {
      "customType": "regex",
      "description": "mise: go toolchain pin",
      "managerFilePatterns": ["/(^|/)mise\\.toml$/"],
      "matchStrings": ["go = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "loose",
      "autoReplaceStringTemplate": "go = \"{{newValue}}\""
    },
    {
      "customType": "regex",
      "description": "mise: python toolchain pin",
      "managerFilePatterns": ["/(^|/)mise\\.toml$/"],
      "matchStrings": ["python = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "python/cpython",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "python = \"{{newValue}}\""
    },
    {
      "customType": "regex",
      "description": "mise: uv pin",
      "managerFilePatterns": ["/(^|/)mise\\.toml$/"],
      "matchStrings": ["uv = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases",
      "autoReplaceStringTemplate": "uv = \"{{newValue}}\""
    },
    {
      "customType": "regex",
      "description": "mise: kubectl version pin",
      "managerFilePatterns": ["/(^|/)mise\\.toml$/"],
      "matchStrings": ["kubectl = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "kubectl = \"{{newValue}}\""
    },
    {
      "customType": "regex",
      "description": "mise: kind version pin",
      "managerFilePatterns": ["/(^|/)mise\\.toml$/"],
      "matchStrings": ["kind = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "kind = \"{{newValue}}\""
    },
    {
      "customType": "regex",
      "description": "mise: helm version pin",
      "managerFilePatterns": ["/(^|/)mise\\.toml$/"],
      "matchStrings": ["helm = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "helm = \"{{newValue}}\""
    },
    {
      "customType": "regex",
      "description": "mise: flux2 CLI pin (floating latest tag)",
      "managerFilePatterns": ["/(^|/)mise\\.toml$/"],
      "matchStrings": ["flux2 = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "flux2 = \"{{newValue}}\""
    },
    {
      "customType": "regex",
      "description": "mise: min_version self-pin",
      "managerFilePatterns": ["/(^|/)mise\\.toml$/"],
      "matchStrings": ["min_version = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "min_version = \"{{newValue}}\""
    },
    {
      "customType": "regex",
      "description": "toolbox image: mise CLI pin",
      "managerFilePatterns": ["bootstrap-rs/Dockerfile"],
      "matchStrings": ["ARG MISE_VERSION=(?<currentValue>[0-9][^\\s]*)"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "ARG MISE_VERSION={{newValue}}"
    },
    {
      "customType": "regex",
      "description": "toolbox image: podman remote client pin",
      "managerFilePatterns": ["bootstrap-rs/Dockerfile"],
      "matchStrings": ["ARG PODMAN_VERSION=(?<currentValue>[0-9][^\\s]*)"],
      "depNameTemplate": "containers/podman",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "ARG PODMAN_VERSION={{newValue}}"
    },
    // ── bootstrap.toml chart pins (annotation-driven) ─────────────────────
    // Datasource and depName live in `# renovate:` comments next to the
    // chart pins in bootstrap.toml (consumed by the Rust binary since the
    // externalization); this one manager covers every annotated pin
    // without per-dependency configuration.
    {
      "customType": "regex",
      "description": "Annotated chart pins in bootstrap.toml",
      "managerFilePatterns": ["/(^|/)bootstrap\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z0-9-]+)(?: registryUrl=(?<registryUrl>\\S+))? depName=(?<depName>\\S+)(?: versioning=(?<versioning>[a-z0-9-]+))?\n[a-zA-Z0-9_-]+ = \"(?<currentValue>[^\\\"]+)\""
      ]
    }
    // ── end customManagers ────────────────────────────────────────────────
  ],
  "packageRules": [
    {
      "description": "Pin toolbox image base images by digest",
      "matchDatasources": ["docker"],
      "matchFileNames": ["bootstrap-rs/Dockerfile"],
      "pinDigests": true
    },
    {
      "description": "No automerge by default; merges stay manual. The next rule is the only exception",
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": false
    },
    {
      "description": "Group GitHub Actions only, excluding workflow images and runners",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "groupName": "github-actions"
    }
  ]
}
